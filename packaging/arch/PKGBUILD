# Maintainer: Simeon Higgs <simeon.higgs@gmail.com>
#
# Jones3D Portable (OpenJones3D), the native Linux build of the Indiana Jones and the Infernal Machine engine.
# The game data isn't part of the package: on first start the game asks to install it to ~/.Jones3D
# from a Steam installation, the GOG offline installer or the original CDs.

pkgname=jones3d-portable
pkgver=0.3.1.r0.g0000000
pkgrel=1
pkgdesc="Open source engine for Indiana Jones and the Infernal Machine (needs the original game data)"
arch=('x86_64')
url="https://github.com/SimeonH/Jones3D-Portable"
license=('AGPL-3.0-only' 'LGPL-2.1-only') # LGPL: libmspack (CHM help)
depends=(
  'cairo'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'libjpeg-turbo'
  'libpng'
  'libx11'
  'libxkbcommon'
  'pango'
  'sdl3'
  'vulkan-icd-loader' # Loaded at runtime by volk
)
makedepends=(
  'alsa-lib'   # OpenAL Soft backends, loaded at runtime
  'clang'
  'cmake'
  'git'
  'libpulse'
  'ninja'
  'pipewire'
)
optdepends=(
  'innoextract: install the game data from the GOG offline installer'
  'pipewire: sound output'
  'libpulse: sound output with PulseAudio'
  'alsa-lib: sound output with ALSA'
)
conflicts=('openjones3d-git')
replaces=('openjones3d-git') # Former package name
# The engine is decompiled code that relies on exact float and memory semantics, keep it out of LTO
options=('!lto')

_branch=main
source=(
  "Jones3D-Portable::git+https://github.com/SimeonH/Jones3D-Portable.git#branch=${_branch}"
  # Dependencies the CMake build would otherwise download (see Libs/external)
  "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.8/wxWidgets-3.2.8.tar.bz2"
  "openal-soft-1.24.3.tar.gz::https://github.com/kcat/openal-soft/archive/refs/tags/1.24.3.tar.gz"
  "Vulkan-Headers-1.4.304.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v1.4.304.tar.gz"
  "volk-1.4.304.tar.gz::https://github.com/zeux/volk/archive/refs/tags/1.4.304.tar.gz"
  "libmspack-1.11.tar.gz::https://github.com/kyz/libmspack/archive/refs/tags/v1.11.tar.gz"
  "jones3d-portable.desktop"
)
sha256sums=('SKIP'
            'c74784904109d7229e6894c85cfa068f1106a4a07c144afd78af41f373ee0fe6'
            '7e1fecdeb45e7f78722b776c5cf30bd33934b961d7fd2a11e0494e064cc631ce'
            '5e1a06b3f27e7581b55d1dea176fd97ee0a2f299406db2f437c1d2f297ceba5b'
            'ab3d4a8ccaeb32652259cdd008399504a41792675b0421d90b67729ee274746f'
            '284e0e51fee991c40e8cbbc0f5e635f99722796a3642a14397989fc00b862f72'
            'SKIP')

pkgver() {
  cd Jones3D-Portable
  local version
  version=$(sed -n 's/^project(OpenJones3D VERSION \([0-9.]*\)).*/\1/p' CMakeLists.txt)
  printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  # Keep build paths out of the binaries (wx assert file names)
  CFLAGS+=" -ffile-prefix-map=$srcdir=."
  CXXFLAGS+=" -ffile-prefix-map=$srcdir=."

  cmake -S Jones3D-Portable -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DJONES3D_BUILD_PROGRAMS=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_WXWIDGETS="$srcdir/wxWidgets-3.2.8" \
    -DFETCHCONTENT_SOURCE_DIR_OPENALSOFT="$srcdir/openal-soft-1.24.3" \
    -DFETCHCONTENT_SOURCE_DIR_VULKANHEADERS="$srcdir/Vulkan-Headers-1.4.304" \
    -DFETCHCONTENT_SOURCE_DIR_VOLK="$srcdir/volk-1.4.304" \
    -DFETCHCONTENT_SOURCE_DIR_LIBMSPACK="$srcdir/libmspack-1.11"
  cmake --build build
}

package() {
  install -Dm755 build/Jones3D/jones3d-portable "$pkgdir/usr/lib/jones3d-portable/jones3d-portable"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/jones3d-portable/jones3d-portable "$pkgdir/usr/bin/jones3d-portable"

  install -Dm644 jones3d-portable.desktop "$pkgdir/usr/share/applications/jones3d-portable.desktop"
  install -Dm644 Jones3D-Portable/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 Jones3D-Portable/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
